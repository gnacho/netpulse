#!/bin/sh /etc/rc.common
# =============================================================================
# netpulse-agent — agente nativo NetPulse para OpenWrt (SPEC-AGENTE-PILOTO §2)
#
# procd con respawn; logs del agente (stderr) van a syslog (logread -e
# netpulse-agent). La config vive en /etc/netpulse-agent.env (chmod 600) —
# procd reinicia el servicio si ese fichero cambia (procd_set_param file).
#
# Variante /tmp (equipos con flash justa): si el binario no está en
# /usr/sbin se usa /tmp/netpulse-agent (RAM; hay que reinstalar tras reboot —
# ver install-agent.sh --tmp).
# =============================================================================

START=99
STOP=10
USE_PROCD=1

BIN=/usr/sbin/netpulse-agent
[ -x "$BIN" ] || BIN=/tmp/netpulse-agent

start_service() {
    procd_open_instance netpulse-agent
    procd_set_param command "$BIN"
    # respawn: si muere, procd lo levanta (5 s entre intentos, 5 intentos/hora)
    procd_set_param respawn "${respawn_threshold:-3600}" "${respawn_timeout:-5}" "${respawn_retry:-5}"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/netpulse-agent.env
    procd_close_instance
}
