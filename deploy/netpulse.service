# NetPulse — unit systemd (BACKEND NODE LEGACY, SOLO HISTÓRICO)
# ⚠️ DECISIÓN 5-Ago-2026: el backend Go (deploy/netpulse-go.service) es el
# único desplegable. Esta unidad se conserva como referencia del fallback Node
# antiguo (legacy/server-node/) pero NO se usa en nuevos deploys.
# NOTA: la skill 'infraestructura' del usuario refinará este fichero en el
# despliegue real (puerto 80 con CAP_NET_BIND_SERVICE, reverse proxy HTTPS, etc).
# Esta unidad es el punto de partida razonable: usuario dedicado, hardening
# básico y arranque tras la red.
#
# Instalación (NO usar; solo histórico):
#   sudo useradd --system --home /opt/netpulse --shell /usr/sbin/nologin netpulse
#   sudo cp deploy/netpulse.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now netpulse

[Unit]
Description=NetPulse — dashboard de monitorización de red doméstica
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=netpulse
Group=netpulse
WorkingDirectory=/opt/netpulse/legacy/server-node
EnvironmentFile=/opt/netpulse/legacy/server-node/.env
# NODE_ENV ya viene en .env; descomentar para forzar:
#Environment=NODE_ENV=production
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# La DB vive en DATA_DIR; el auto-actualizador escribe en todo /opt/netpulse
ReadWritePaths=/opt/netpulse
# NOTA modo live: ProtectHome=true impide leer claves SSH bajo /home o /root.
# Coloca la clave de los routers en /opt/netpulse/server/data/.ssh (o ajusta
# SSH_KEY_PATH + ReadWritePaths/ProtectHome en consecuencia).
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
