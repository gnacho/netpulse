# NetPulse (backend Go) — unit systemd
# NOTA: la skill 'infraestructura' del usuario refinará este fichero en el
# despliegue real (puerto 80 con CAP_NET_BIND_SERVICE, reverse proxy HTTPS, etc).
#
# Instalación (migrando desde la versión Node):
#   1. Descarga el binario de CI (release go-latest) o compílalo (ver server-go/README.md)
#      y colócalo en /opt/netpulse/server-go/netpulse (con .env junto a él).
#   2. DATA_DIR: apunta al MISMO directorio de datos que usaba la versión Node
#      (p. ej. /opt/netpulse/server/data): el primer arranque migra la DB
#      automáticamente (backup netpulse.db.bak-<timestamp> incluido; usuarios,
#      sesiones vivas, routers y métricas se conservan).
#   3. sudo cp deploy/netpulse-go.service /etc/systemd/system/
#      sudo systemctl daemon-reload && sudo systemctl enable --now netpulse-go
#   4. El flag de reinicio del updater pasa a ser
#      /opt/netpulse/server-go/data/.restart-me — añádelo a netpulse-restart.path
#      (o crea una unidad path equivalente que haga `systemctl restart netpulse-go`).

[Unit]
Description=NetPulse (Go) — dashboard de monitorización de red doméstica
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=netpulse
Group=netpulse
WorkingDirectory=/opt/netpulse/server-go
EnvironmentFile=/opt/netpulse/server-go/.env
ExecStart=/opt/netpulse/server-go/netpulse
Restart=on-failure
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# La DB vive en DATA_DIR; el auto-actualizador escribe en todo /opt/netpulse
ReadWritePaths=/opt/netpulse
# NOTA modo live: ProtectHome=true impide leer claves SSH bajo /home o /root.
# Coloca la clave de los routers en DATA_DIR/.ssh (o ajusta SSH_KEY_PATH +
# ReadWritePaths/ProtectHome en consecuencia).
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
