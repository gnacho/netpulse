# /etc/config/netpulse — UCI config del servidor on-box (Fase 9)
# Gestionado por opkg; se preserva en upgrades (conffiles).
# El servidor lee esta sección vía internal/config/uci.go (R5).
# Tras editar: /etc/init.d/netpulse reload + restart

config server 'server'
	# Puerto HTTP(S) del servidor. 3100 por defecto: en el firmware GL.iNet
	# la UI de AdGuard Home ya usa 3000 (#1701). Cámbialo si el puerto
	# está libre en tu equipo.
	option port '3100'

	# Directorio de datos (SQLite). Default: overlay (flash).
	# Si hay USB montado: option data_dir '/mnt/netpulse-data'
	# Cualquier ruta fuera del overlay debe estar MONTADA al arrancar: el
	# servicio se niega a arrancar sobre una ruta sin montaje para no
	# crear la base de datos en flash (#1701).
	option data_dir '/usr/local/netpulse-data'

	# Motor SQLite (#1700): todos los despliegues van en WAL + synchronous
	# NORMAL + temp_store MEMORY (el DELETE+FULL previo escribía ~3,3x más
	# en flash/USB). Descomenta la primera para restaurar el modo antiguo
	# (journal DELETE + FULL) o la segunda para tirar los temporales a
	# disco ('file' o 'default' en vez de 'memory').
	# option db_rollback_journal '0'
	# option db_temp_store 'memory'

	# Usuario admin inicial (default: admin; la contraseña se genera en
	# el primer arranque y se muestra UNA vez en logread).
	option auth_user 'admin'

	# Modo demo (dataset de prueba; default 0)
	option demo_mode '0'
