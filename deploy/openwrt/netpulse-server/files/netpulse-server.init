#!/bin/sh /etc/rc.common
# netpulse-server - procd init script (Fase 9 R1)
# Arranca el servidor NetPulse en modo on-box con config UCI.
#
# Compatibilidad OpenWrt 21.02 (#1701):
#   - UNA sola llamada procd_set_param env con todas las variables: en 21.02
#     cada llamada adicional pisa la anterior y solo sobrevive la ultima.
#   - stdout y stderr son parametros booleanos ("1"), no palabras clave.
#   - START=99 para dar tiempo a los montajes USB (block mount) antes de
#     arrancar, mas una guardia que se niega a arrancar si data_dir apunta a
#     un montaje ausente (evita crear la base de datos en flash).

START=99
USE_PROCD=1

PROG=/usr/sbin/netpulse
DATA_DIR=/usr/local/netpulse-data
# 3000 colisiona con la UI de AdGuard Home del firmware GL.iNet (#1701)
DEFAULT_PORT=3100

# resolve_mount imprime el punto de montaje mas profundo que contiene a dir
# ("/" si dir vive en el overlay raiz).
resolve_mount() {
	local dir="$1"
	while [ "$dir" != "/" ]; do
		if grep -qs " $dir " /proc/mounts; then
			echo "$dir"
			return 0
		fi
		dir="$(dirname "$dir")"
	done
	echo "/"
}

start_service() {
	# data_dir: overlay por defecto; USB si esta montado
	local data_dir
	data_dir=$(uci -q get netpulse.server.data_dir 2>/dev/null)
	[ -z "$data_dir" ] && data_dir="$DATA_DIR"
	data_dir="${data_dir%/}"

	# data_dir fuera del overlay por defecto: exigir un montaje real (#1701).
	# Sin esta guardia, mkdir -p crearia el directorio (y la base de datos)
	# en flash cuando el USB todavia no esta montado, y el servidor fallaria
	# silenciosamente a escribir en el sitio previsto.
	if [ "$data_dir" != "$DATA_DIR" ]; then
		local mnt
		mnt=$(resolve_mount "$data_dir")
		if [ "$mnt" = "/" ]; then
			echo "netpulse: data_dir '$data_dir' no esta sobre un montaje; no arranco para no escribir la base en flash"
			logger -t netpulse "data_dir '$data_dir' no esta sobre un montaje; servicio no arrancado (monta el USB y ejecuta /etc/init.d/netpulse start)"
			return 1
		fi
	fi
	mkdir -p "$data_dir"

	local port
	port=$(uci -q get netpulse.server.port 2>/dev/null)
	[ -z "$port" ] && port="$DEFAULT_PORT"

	procd_open_instance
	procd_set_param command "$PROG"
	# Una unica llamada env: en OpenWrt 21.02 cada llamada extra pisaria la
	# anterior y al proceso solo le llegaria la ultima variable (#1701).
	procd_set_param env NETPULSE_ONBOX=1 DATA_DIR="$data_dir" PORT="$port"
	# Booleanos explicitos: "procd_set_param stdout stderr" no es valido y
	# deja los logs sin redirigir a syslog en 21.02 (#1701).
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 0  # respawn tras crash (max 5 en 1h)
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger netpulse
}
