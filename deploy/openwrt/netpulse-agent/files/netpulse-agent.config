# /etc/config/netpulse-agent — UCI config (OpenWrt)
# Gestionado por opkg; se preserva en upgrades (conffiles).
# Tras instalar, edita con `uci set netpulse-agent.main.server=...` o
# `uci commit netpulse-agent` + `/etc/init.d/netpulse-agent restart`.

config main 'main'
	# URL del servidor NetPulse (obligatorio)
	option server ''

	# Token del equipo (64 hex; se muestra UNA vez al crearlo en el servidor)
	option token ''

	# Slug del equipo en NetPulse (obligatorio)
	option slug ''

	# Intervalo de sondeo completo (default 30s)
	option interval '30s'

	# Ping WAN (solo gateway; p. ej. 1.1.1.1)
	# option wan_target '1.1.1.1'

	# Ping al gateway (solo APs; p. ej. 192.168.1.1)
	# option gw_target '192.168.1.1'

	# Aceptar TLS autofirmado (LAN sin CA; default 0)
	# option insecure_tls '0'
