# Mismo .env que la versión Node (mismas variables, mismo formato).
# NODE_ENV no aplica al binario Go (se ignora si está presente).
PORT=3000
STATIC_DIR=../app/dist     # opcional; tiene prioridad sobre el frontend embebido
DATA_DIR=./data
SESSION_SECRET=            # opcional; autogenerado y persistido en kv si falta
AUTH_USER=admin
AUTH_PASS=cambia-esto      # hash bcrypt en kv tras primer login
DEMO_MODE=0                # 1 = dataset de demostración (sin escribir en la BD)
MAX_SSE_CLIENTS=10

# --- Modo live ---
# Routers: la tabla `routers` de SQLite es la fuente de verdad y nace VACÍA.
# En el primer arranque se autodetecta la puerta de enlace (ip route + sondeo
# SSH) y el resto se añade desde Ajustes. ROUTERS_JSON solo se usa como
# semilla opcional si la tabla está vacía.
# ROUTERS_JSON=[{"id":"flint2","name":"Gateway","host":"192.168.1.1","type":"glinet"},{"id":"living","host":"192.168.1.2","type":"openwrt"}]
SSH_KEY_PATH=~/.ssh/id_ed25519
ADGUARD_URL=http://192.168.1.1
ADGUARD_USER=admin
ADGUARD_PASS=
WG_INTERFACE=wg0

# --- Auto-rearme de agentes (Fase 6.1+) ---
# 1 = el supervisor rearma automáticamente los agentes cuyo último push
# expiró (TTL). Opt-in: nada autónomo sobre equipamiento de red sin
# confirmación explícita. Cooldown entre intentos automáticos por slug.
NETPULSE_AUTO_REARM=0
NETPULSE_AUTO_REARM_COOLDOWN_S=600
